<?xml version="1.0" encoding="UTF-8"?>
<domain-model project="DetiBuddy" version="1.0" institution="Universidade de Aveiro" course="Projeto em Engenharia Informática (PEI)" phase="Fase de Elaboração">
  <description>Modelo de Domínio Conceptual UML do assistente conversacional inteligente DetiBuddy. Contém 18 classes conceptuais distribuídas por 5 aglomerados funcionais.</description>
  <clusters>
    <cluster id="C1" name="Identidade e Conversação" persistence="PostgreSQL + Redis (sessões)">
      <description>Modela o acesso seguro, auditoria de conversas, perfis de utilizador e privacidade.</description>
      <classes>
        <class name="Utilizador" stereotype="Entity">
          <description>Entidade central representativa do indivíduo na UA.</description>
          <attributes>
            <attribute name="nmec" type="String" visibility="public" description="Número mecanográfico único"/>
            <attribute name="nome" type="String" visibility="public" description="Nome completo do utilizador"/>
            <attribute name="emailInstitucional" type="String" visibility="public" description="Endereço institucional @ua.pt"/>
            <attribute name="perfil" type="TipoPerfil" visibility="public" description="ESTUDANTE, DOCENTE, ADMINISTRADOR, VISITANTE"/>
            <attribute name="dataRegisto" type="DateTime" visibility="public" description="Timestamp de criação de conta"/>
          </attributes>
        </class>
        <class name="Estudante" stereotype="Entity" extends="Utilizador">
          <description>Especialização de Utilizador com dados curriculares.</description>
          <attributes>
            <attribute name="curso" type="String" visibility="public" description="Sigla ou nome do curso (ex: MIEI, LEI)"/>
            <attribute name="anoCurricular" type="Int" visibility="public" description="Ano curricular atual (1..5)"/>
            <attribute name="estatutoEspecial" type="String" visibility="public" description="Trabalhador-estudante, atleta, dirigente, etc."/>
          </attributes>
        </class>
        <class name="Docente" stereotype="Entity" extends="Utilizador">
          <description>Especialização de Utilizador para o corpo docente.</description>
          <attributes>
            <attribute name="departamento" type="String" visibility="public" description="Departamento de afetação (ex: DETI)"/>
            <attribute name="gabinete" type="String" visibility="public" description="Identificador do gabinete físico"/>
            <attribute name="horarioAtendimento" type="String" visibility="public" description="Horário semanal de atendimento"/>
          </attributes>
        </class>
        <class name="Sessao" stereotype="Entity">
          <description>Sessão temporária de interação no assistente.</description>
          <attributes>
            <attribute name="idSessao" type="UUID" visibility="public" description="Identificador único da sessão"/>
            <attribute name="canalOrigem" type="Canal" visibility="public" description="REACT_PWA, DISCORD, etc."/>
            <attribute name="dataInicio" type="DateTime" visibility="public" description="Timestamp de início da sessão"/>
            <attribute name="expiraEm" type="DateTime" visibility="public" description="Prazo de validade / TTL"/>
            <attribute name="ativa" type="Boolean" visibility="public" description="Estado de atividade da sessão"/>
          </attributes>
        </class>
        <class name="Conversa" stereotype="Entity">
          <description>Thread conversacional associada a uma sessão.</description>
          <attributes>
            <attribute name="idConversa" type="UUID" visibility="public" description="Identificador da conversa"/>
            <attribute name="tituloResumo" type="String" visibility="public" description="Sumário ou tema da conversa"/>
            <attribute name="criadaEm" type="DateTime" visibility="public" description="Timestamp de criação"/>
          </attributes>
        </class>
        <class name="Mensagem" stereotype="Entity">
          <description>Intercâmbio atómico de mensagem textual no diálogo.</description>
          <attributes>
            <attribute name="idMensagem" type="UUID" visibility="public" description="Identificador único da mensagem"/>
            <attribute name="autor" type="PapelAutor" visibility="public" description="USER, ASSISTANT, SYSTEM"/>
            <attribute name="textoConteudo" type="String" visibility="public" description="Conteúdo textual da mensagem"/>
            <attribute name="timestamp" type="DateTime" visibility="public" description="Momento de envio/geração"/>
            <attribute name="tokensProcessados" type="Int" visibility="public" description="Total de tokens de input/output"/>
          </attributes>
        </class>
        <class name="Feedback" stereotype="Entity">
          <description>Avaliação voluntária da resposta fornecida pelo assistente.</description>
          <attributes>
            <attribute name="idFeedback" type="UUID" visibility="public" description="Identificador do feedback"/>
            <attribute name="rating" type="Classificacao" visibility="public" description="POSITIVO (+1) ou NEGATIVO (-1)"/>
            <attribute name="comentario" type="String" visibility="public" description="Comentário textual opcional"/>
            <attribute name="registadoEm" type="DateTime" visibility="public" description="Timestamp de submissão"/>
          </attributes>
        </class>
      </classes>
    </cluster>
    <cluster id="C2" name="Conhecimento &amp; RAG" persistence="PostgreSQL (metadados) + pgvector (HNSW embeddings)">
      <description>Modela o conhecimento documental oficial da UA e a sua recuperação vetorial fundamentada.</description>
      <classes>
        <class name="DocumentoNormativo" stereotype="Entity">
          <description>Regulamentos, despachos ou planos de estudo oficiais.</description>
          <attributes>
            <attribute name="idDocumento" type="UUID" visibility="public" description="Identificador único do documento"/>
            <attribute name="titulo" type="String" visibility="public" description="Título oficial do regulamento"/>
            <attribute name="categoria" type="TipoDocumento" visibility="public" description="REGULAMENTO, DESPACHO, CALENDARIO"/>
            <attribute name="orgaoEmissor" type="String" visibility="public" description="Senado, Reitoria, Conselho Pedagógico"/>
            <attribute name="dataAprovacao" type="Date" visibility="public" description="Data de homologação"/>
            <attribute name="dataValidade" type="Date" visibility="public" description="Data limite ou null se indeterminado"/>
            <attribute name="estado" type="EstadoDoc" visibility="public" description="VIGENTE, REVOGADO"/>
          </attributes>
        </class>
        <class name="ChunkDocumento" stereotype="Entity">
          <description>Fragmento textual indexado com vetor denso para busca semântica.</description>
          <attributes>
            <attribute name="idChunk" type="UUID" visibility="public" description="Identificador do fragmento"/>
            <attribute name="sequencia" type="Int" visibility="public" description="Ordem sequencial no documento"/>
            <attribute name="textoExcerto" type="String" visibility="public" description="Excerto de texto bruto"/>
            <attribute name="embedding" type="Vector1536" visibility="public" description="Vetor denso (OpenAI text-embedding-3-small)"/>
            <attribute name="artigoReferenciado" type="String" visibility="public" description="Artigo ou secção legal identificada"/>
            <attribute name="pagina" type="Int" visibility="public" description="Página correspondente no documento original"/>
          </attributes>
        </class>
        <class name="CitacaoFonte" stereotype="ValueObject">
          <description>Metadado de fundamentação legal anexado à resposta do agente.</description>
          <attributes>
            <attribute name="artigoFormal" type="String" visibility="public" description="Ex: Artigo 14.º, N.º 2"/>
            <attribute name="documentoOrigem" type="String" visibility="public" description="Nome do documento fonte citado"/>
            <attribute name="scoreSimilaridade" type="Float" visibility="public" description="Score cosseno de similaridade"/>
            <attribute name="urlOficial" type="String" visibility="public" description="Ligação web para consulta do documento oficial"/>
          </attributes>
        </class>
      </classes>
    </cluster>
    <cluster id="C3" name="Académico (PACO &amp; Moodle)" persistence="Mock PACO OpenAPI / Moodle API + Cache Redis">
      <description>Modela o percurso discente, unidades curriculares, horários de aulas e avaliações.</description>
      <classes>
        <class name="UnidadeCurricular" stereotype="Entity">
          <description>Disciplina ou módulo do plano curricular.</description>
          <attributes>
            <attribute name="codigoUC" type="String" visibility="public" description="Código da disciplina na UA"/>
            <attribute name="designacao" type="String" visibility="public" description="Nome por extenso da disciplina"/>
            <attribute name="sigla" type="String" visibility="public" description="Sigla da UC (ex: PEI, IA, SO)"/>
            <attribute name="anoLetivo" type="String" visibility="public" description="Ex: 2026/2027"/>
            <attribute name="semestre" type="Int" visibility="public" description="1 ou 2"/>
            <attribute name="ects" type="Float" visibility="public" description="Créditos ECTS atribuídos"/>
          </attributes>
        </class>
        <class name="Inscricao" stereotype="Entity">
          <description>Inscrição ativa de um estudante numa UC.</description>
          <attributes>
            <attribute name="anoMatricula" type="String" visibility="public" description="Ano letivo da matrícula"/>
            <attribute name="estado" type="EstadoInscricao" visibility="public" description="INSCRITO, APROVADO, REPROVADO"/>
            <attribute name="turmaPratica" type="String" visibility="public" description="Identificador da turma prática (ex: P1, PL2)"/>
          </attributes>
        </class>
        <class name="AulaHorario" stereotype="Entity">
          <description>Bloco horário semanal de lecionação de uma UC.</description>
          <attributes>
            <attribute name="diaSemana" type="DiaSemana" visibility="public" description="SEGUNDA, TERCA, QUARTA, QUINTA, SEXTA"/>
            <attribute name="horaInicio" type="Time" visibility="public" description="Hora de início (ex: 09:00)"/>
            <attribute name="horaFim" type="Time" visibility="public" description="Hora de término (ex: 11:00)"/>
            <attribute name="tipologia" type="TipoAula" visibility="public" description="TEORICA, TEORICO_PRATICA, LABORATORIAL"/>
            <attribute name="sala" type="String" visibility="public" description="Sala designada (ex: 4.1.20)"/>
            <attribute name="edificio" type="String" visibility="public" description="Edifício / Departamento (ex: DETI)"/>
          </attributes>
        </class>
        <class name="Avaliacao" stereotype="Entity">
          <description>Momento de avaliação discente (teste, exame, projeto).</description>
          <attributes>
            <attribute name="idAvaliacao" type="UUID" visibility="public" description="Identificador da prova"/>
            <attribute name="tipo" type="TipoAvaliacao" visibility="public" description="TESTE, EXAME, PROJETO, DEFESA"/>
            <attribute name="dataHora" type="DateTime" visibility="public" description="Data e hora de realização"/>
            <attribute name="sala" type="String" visibility="public" description="Sala ou auditório atribuído"/>
            <attribute name="pesoPercentual" type="Float" visibility="public" description="Ponderação na nota final (0..100%)"/>
          </attributes>
        </class>
      </classes>
    </cluster>
    <cluster id="C4" name="Serviços de Campus &amp; Logística" persistence="Redis (dados efêmeros em tempo real com TTL 15 min)">
      <description>Modela infraestruturas de campus em tempo real: cantinas, estacionamento, atendimento e meteorologia.</description>
      <classes>
        <class name="Cantina" stereotype="Entity">
          <description>Refeitório dos Serviços de Ação Social (SAS) da UA.</description>
          <attributes>
            <attribute name="nomeCantina" type="String" visibility="public" description="Ex: Cantina do Crasto, Santiago, Refeitório Central"/>
            <attribute name="localizacaoCampus" type="String" visibility="public" description="Zona geográfica no Campus"/>
          </attributes>
        </class>
        <class name="EmentaDiaria" stereotype="Entity">
          <description>Cardápio do dia para almoço ou jantar numa cantina.</description>
          <attributes>
            <attribute name="dataRefeicao" type="Date" visibility="public" description="Data de serviço"/>
            <attribute name="refeicao" type="TipoRefeicao" visibility="public" description="ALMOCO, JANTAR"/>
            <attribute name="pratoCarne" type="String" visibility="public" description="Descrição do prato de carne"/>
            <attribute name="pratoPeixe" type="String" visibility="public" description="Descrição do prato de peixe"/>
            <attribute name="opcaoVegetariana" type="String" visibility="public" description="Descrição do prato vegetariano"/>
            <attribute name="opcaoDieta" type="String" visibility="public" description="Descrição do prato de dieta"/>
            <attribute name="sopa" type="String" visibility="public" description="Sopa do dia"/>
          </attributes>
        </class>
        <class name="ParqueEstacionamento" stereotype="Entity">
          <description>Parque automóvel com sensores de ocupação em tempo real.</description>
          <attributes>
            <attribute name="nomeParque" type="String" visibility="public" description="Ex: Parque DETI, Parque Crasto"/>
            <attribute name="lotacaoMaxima" type="Int" visibility="public" description="Total de vagas disponíveis"/>
            <attribute name="lugaresOcupados" type="Int" visibility="public" description="Vagas preenchidas no instante"/>
            <attribute name="taxaOcupacao" type="Float" visibility="public" description="Percentagem de ocupação (0..100%)"/>
            <attribute name="dataTelemetria" type="DateTime" visibility="public" description="Momento da última leitura de sensor"/>
          </attributes>
        </class>
        <class name="ServicoAtendimento" stereotype="Entity">
          <description>Balcão presencial de atendimento (ex: Balcão Único, Tesouraria).</description>
          <attributes>
            <attribute name="nomeServico" type="String" visibility="public" description="Designação do balcão"/>
            <attribute name="localizacaoBalcao" type="String" visibility="public" description="Edifício e sala do balcão"/>
          </attributes>
        </class>
        <class name="SenhaAtendimento" stereotype="Entity">
          <description>Senha eletrónica de atendimento em fila pública.</description>
          <attributes>
            <attribute name="letraNumero" type="String" visibility="public" description="Ex: A14, B03"/>
            <attribute name="estado" type="EstadoSenha" visibility="public" description="EM_ESPERA, A_ATENDER, EXPIRADA"/>
            <attribute name="dataEmissao" type="DateTime" visibility="public" description="Hora de tiragem da senha"/>
            <attribute name="tempoEsperaEstimadoMin" type="Int" visibility="public" description="Minutos estimados até ser chamada"/>
          </attributes>
        </class>
        <class name="PrevisaoMeteorologica" stereotype="Entity">
          <description>Dados meteorológicos oficiais fornecidos pelo IPMA para Aveiro.</description>
          <attributes>
            <attribute name="dataHora" type="DateTime" visibility="public" description="Período da previsão"/>
            <attribute name="temperaturaMin" type="Float" visibility="public" description="Temperatura mínima em °C"/>
            <attribute name="temperaturaMax" type="Float" visibility="public" description="Temperatura máxima em °C"/>
            <attribute name="probabilidadeChuva" type="Int" visibility="public" description="Probabilidade de precipitação (0..100%)"/>
            <attribute name="condicaoCeu" type="String" visibility="public" description="Limpo, nublado, aguaceiros, etc."/>
          </attributes>
        </class>
      </classes>
    </cluster>
    <cluster id="C5" name="Alertas e Proatividade" persistence="PostgreSQL (notificações) + Redis (filas de tarefas assíncronas ARQ)">
      <description>Modela notificações push e automações periódicas disparadas em segundo plano pelo ARQ Worker.</description>
      <classes>
        <class name="SubscricaoAlerta" stereotype="Entity">
          <description>Registo de interesse do utilizador para receber alertas proativos.</description>
          <attributes>
            <attribute name="idSubscricao" type="UUID" visibility="public" description="Identificador da subscrição"/>
            <attribute name="tipo" type="TipoAlerta" visibility="public" description="SENHA_PROXIMA, TESTE_PROXIMO, PARQUE_LIVRE"/>
            <attribute name="canal" type="CanalEntrega" visibility="public" description="WEB_PUSH, DISCORD_DM, EMAIL"/>
            <attribute name="ativo" type="Boolean" visibility="public" description="Se o alerta se encontra ativo"/>
            <attribute name="criadaEm" type="DateTime" visibility="public" description="Timestamp de subscrição"/>
          </attributes>
        </class>
        <class name="Notificacao" stereotype="Entity">
          <description>Mensagem de alerta disparada e entregue ao utilizador.</description>
          <attributes>
            <attribute name="idNotificacao" type="UUID" visibility="public" description="Identificador da notificação"/>
            <attribute name="titulo" type="String" visibility="public" description="Título da notificação"/>
            <attribute name="conteudo" type="String" visibility="public" description="Corpo da mensagem do alerta"/>
            <attribute name="dataEnvio" type="DateTime" visibility="public" description="Timestamp de envio"/>
            <attribute name="estado" type="EstadoEntrega" visibility="public" description="PENDENTE, ENTREGUE, FALHADA"/>
          </attributes>
        </class>
      </classes>
    </cluster>
  </clusters>
  <relationships>
    <relationship type="Generalization" source="Estudante" target="Utilizador" label="herda"/>
    <relationship type="Generalization" source="Docente" target="Utilizador" label="herda"/>
    <relationship type="Association" source="Utilizador" target="Sessao" label="estabelece" multiplicitySource="1" multiplicityTarget="0..*"/>
    <relationship type="Association" source="Sessao" target="Conversa" label="agrega" multiplicitySource="1" multiplicityTarget="1..*"/>
    <relationship type="Association" source="Conversa" target="Mensagem" label="contém" multiplicitySource="1" multiplicityTarget="1..*"/>
    <relationship type="Association" source="Mensagem" target="Feedback" label="recebe" multiplicitySource="1" multiplicityTarget="0..1"/>
    <relationship type="Dependency" source="Mensagem" target="CitacaoFonte" label="cita" multiplicitySource="1" multiplicityTarget="0..*"/>
    <relationship type="Composition" source="DocumentoNormativo" target="ChunkDocumento" label="particionado" multiplicitySource="1" multiplicityTarget="1..*"/>
    <relationship type="Association" source="ChunkDocumento" target="CitacaoFonte" label="fornece evidência a" multiplicitySource="1" multiplicityTarget="0..*"/>
    <relationship type="Association" source="Estudante" target="Inscricao" label="possui" multiplicitySource="1" multiplicityTarget="1..*"/>
    <relationship type="Association" source="Inscricao" target="UnidadeCurricular" label="refere" multiplicitySource="0..*" multiplicityTarget="1"/>
    <relationship type="Association" source="Docente" target="UnidadeCurricular" label="leciona" multiplicitySource="1" multiplicityTarget="0..*"/>
    <relationship type="Association" source="UnidadeCurricular" target="AulaHorario" label="tem associada" multiplicitySource="1" multiplicityTarget="1..*"/>
    <relationship type="Association" source="UnidadeCurricular" target="Avaliacao" label="agenda" multiplicitySource="1" multiplicityTarget="0..*"/>
    <relationship type="Association" source="Cantina" target="EmentaDiaria" label="serve" multiplicitySource="1" multiplicityTarget="0..*"/>
    <relationship type="Association" source="ServicoAtendimento" target="SenhaAtendimento" label="despacha" multiplicitySource="1" multiplicityTarget="0..*"/>
    <relationship type="Association" source="Utilizador" target="SubscricaoAlerta" label="subscreve" multiplicitySource="1" multiplicityTarget="0..*"/>
    <relationship type="Association" source="SubscricaoAlerta" target="Notificacao" label="despoleta" multiplicitySource="1" multiplicityTarget="0..*"/>
    <relationship type="Dependency" source="SubscricaoAlerta" target="SenhaAtendimento" label="vigia senha / fila" multiplicitySource="0..*" multiplicityTarget="0..1"/>
    <relationship type="Dependency" source="SubscricaoAlerta" target="Avaliacao" label="alerta teste / entrega" multiplicitySource="0..*" multiplicityTarget="0..1"/>
    <relationship type="Dependency" source="SubscricaoAlerta" target="ParqueEstacionamento" label="vigia lotação" multiplicitySource="0..*" multiplicityTarget="0..1"/>
  </relationships>
</domain-model>
